{
  "name": "civic-law-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "import:federal": "node scripts/import-federal-civic-items.mjs",
    "import:federal-officials": "node scripts/import-federal-official-data.mjs",
    "import:federal-votes": "python3 scripts/import-federal-votes.py",
    "import:representatives": "node scripts/import-representative-directory.mjs",
    "import:florida": "node scripts/import-florida-official-data.mjs && python3 scripts/enrich-florida-rollcall-members.py && python3 scripts/enrich-florida-floor-votes.py",
    "import:florida-house": "python3 scripts/import-florida-house-data.py",
    "sync:supabase": "node scripts/sync-supabase-data.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  }
}
